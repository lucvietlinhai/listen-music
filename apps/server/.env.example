PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=
DATABASE_URL=postgresql://postgres:password@localhost:5432/listenwithme

# Optional: Upstash Redis URL, example:
# REDIS_URL=rediss://default:password@host:6379

# Optional: YouTube API key
# YOUTUBE_API_KEY=

# Optional: AI Voice provider (FPT AI)
# FPTAI_API_KEY=
# FPTAI_VOICE=banmai
# FPTAI_SPEED=0

# Optional: Supabase Storage for TTS audio files
# When set, synthesized audio is uploaded to Supabase Storage (bucket: tts-audio)
# instead of being cached as Base64 data URLs in Redis/Memory.
# Create a public bucket named "tts-audio" in your Supabase project first.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
